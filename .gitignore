node_modules
dist
.vercel
*.local
.DS_Store

# Scratch renders from the Gate 2 critic loop. Only the judged sets are kept:
# a hundred-odd throwaway PNGs an iteration is not history worth carrying.
#
# iter-07 is the set docs/gate-2-verdict.md cites by filename and pixel
# coordinate; gate2b-06 is the set that answers it and the one
# docs/gate-2b-verdict.md cites. Keeping both is what makes every claim in
# either document checkable by someone who was not here.
renders/*
!renders/iter-07/
!renders/gate2b-06/
# the probe's before/after sets, cited by docs/decisions.md D51 to D54
!renders/probe/
renders/probe/*
!renders/probe/before/
!renders/probe/after/
